# Azertica pilot. Points at the Inji stack at inji.azertica.com.
# NOTE: react-native-dotenv inlines these at BUNDLE time, so metro must be started
# with --reset-cache after any change here or you ship a stale bundle.

MIMOTO_HOST=https://inji.azertica.com

# The authorization server Certify's issuer metadata actually advertises. This is
# MOSIP's public mock eSignet, not ours - replace when our Keycloak is up.
ESIGNET_HOST=https://esignet-mock.collab.mosip.net

# Telemetry off for the prototype.
OBSRV_HOST=

APPLICATION_THEME=purple
APPLICATION_LANGUAGE=en

# Leave the in-app host override available while we are iterating on the backend.
CREDENTIAL_REGISTRY_EDIT=false
DEBUG_MODE=false
LIVENESS_DETECTION=false

GOOGLE_ANDROID_CLIENT_ID=''
